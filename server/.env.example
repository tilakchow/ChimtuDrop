# ClipDrop Media Retrieval Server Environment Configuration

# Server Port and Network Binding
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Provider Option 1: RapidAPI Instagram Downloader
# To enable production downloads via RapidAPI, get an API key from rapidapi.com
# and set it below:
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-downloader-download-instagram-videos-stories1.p.rapidapi.com

# Provider Option 2: Meta Developer Graph API
# For official Meta oEmbed/Graph metadata (Format: {app-id}|{client-token})
META_APP_ACCESS_TOKEN=

# Development / Testing Provider
# Set to 'true' to allow verifying the complete preview and download pipeline locally
ENABLE_TEST_PROVIDER=true

# Network Timeout (milliseconds)
REQUEST_TIMEOUT_MS=15000
