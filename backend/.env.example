# ClipDrop FastAPI + yt-dlp Backend Environment Configuration

PORT=8000
HOST=0.0.0.0

# Temporary File Time-To-Live in seconds (default: 30 minutes)
FILE_TTL_SECONDS=1800

# Maximum allowed download file size in Megabytes (default: 250MB)
MAX_FILE_SIZE_MB=250

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=45

# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=5
